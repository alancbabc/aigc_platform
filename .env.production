# ============================================
# AIGC Platform — 生产环境配置
# 复制到服务器后重命名为 .env 使用
# ============================================

# Express 监听端口（Nginx 反向代理使用，不对公网开放）
PORT=3001

# NODE_ENV 通过 PM2/systemd 环境变量注入，不要写在此文件
#   启动示例：NODE_ENV=production pm2 start server/index.js --name aigc-platform

# 允许访问的前端域名（CORS 限制，部署时替换为实际域名）
CORS_ORIGIN=https://your-domain.com

# == 自部署 AI 服务地址（内网） ==
AI_IMAGE_URL=http://10.42.1.2:9000
AI_VIDEO_URL=http://10.42.1.2:8000
AI_TTS_URL=http://10.42.1.2:9200
AI_VOICE_URL=http://10.42.1.2:9300

# == JWT 密钥（生成 64 位随机字符串替换） ==
JWT_SECRET=change-this-to-a-random-secret-in-production
